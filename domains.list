# Domains that go through the proxy. Everything else goes direct.
#
# One matcher per line:
#   domain:example.com       example.com and every subdomain
#   full:api.example.com     exactly this name
#   geosite:google           a named list from geosite.dat
#
# Apply changes with:  sudo ./apply.sh

# OpenAI / ChatGPT / Codex
domain:openai.com
domain:chatgpt.com
domain:oaistatic.com
domain:oaiusercontent.com

# Anthropic / Claude / Claude Code
# claude.com is a separate zone from claude.ai — Claude Code talks to
# platform.claude.com, and without this line it goes direct and gets 403.
domain:anthropic.com
domain:claude.ai
domain:claude.com

# Google Gemini
full:generativelanguage.googleapis.com
domain:aistudio.google.com
